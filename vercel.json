{
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/hosted/health"
    },
    {
      "source": "/signup",
      "destination": "/api/hosted/signup"
    },
    {
      "source": "/waitlist",
      "destination": "/api/hosted/waitlist"
    },
    {
      "source": "/events/beta-click",
      "destination": "/api/hosted/events/beta-click"
    },
    {
      "source": "/v1/:path*",
      "destination": "/api/hosted/v1/:path*"
    }
  ]
}
